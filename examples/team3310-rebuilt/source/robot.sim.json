  "practiceControls": [
    {
      "id": "collect",
      "label": "Collect",
      "kind": "pulse",
      "group": "mode",
      "state": "COLLECT",
      "description": "Deploy intake and collect fuel. Operator B.",
      "binding": {
        "port": 0,
        "button": 2
      }
    },
    {
      "id": "stow",
      "label": "Stow intake",
      "kind": "pulse",
      "group": "mode",
      "state": "DEFENCEIN",
      "description": "Retract intake and stop collection. Operator A.",
      "binding": {
        "port": 0,
        "button": 1
      }
    },
    {
      "id": "deploy",
      "label": "Deploy intake",
      "kind": "pulse",
      "group": "mode",
      "state": "DEFENCEOUT",
      "description": "Deploy intake with rollers off. Operator X.",
      "binding": {
        "port": 0,
        "button": 3
      }
    },
    {
      "id": "snowblow",
      "label": "Snowblow",
      "kind": "pulse",
      "group": "mode",
      "state": "SNOWBLOW",
      "description": "Select the robot snowblow mode. Operator Y.",
      "binding": {
        "port": 0,
        "button": 4
      }
    },
    {
      "id": "shoot",
      "label": "Shoot",
      "kind": "hold",
      "allowedStates": [
        "DEFENCEOUT",
        "COLLECT"
      ],
      "description": "Hold to spin up shooters and feed when ready. Use Collect or Deploy intake first. Operator right trigger.",
      "binding": {
        "port": 0,
        "axis": 3
      }
    },
    {
      "id": "intake",
      "label": "Intake rollers",
      "kind": "hold",
      "description": "Hold to run intake rollers. Driver left trigger.",
      "binding": {
        "port": 1,
        "axis": 2
      }
    },
    {
      "id": "reverse",
      "label": "Reverse intake",
      "kind": "hold",
      "description": "Hold to reverse intake rollers. Driver left bumper.",
      "binding": {
        "port": 1,
        "button": 5
      }
    },
    {
      "id": "jam",
      "label": "Clear jam",
      "kind": "hold",
      "allowedStates": [
        "DEFENCEOUT",
        "COLLECT"
      ],
      "description": "Hold to reverse intake and feed mechanisms. Use Collect or Deploy intake first. Operator left bumper.",
      "binding": {
        "port": 0,
        "button": 5
      }
    }
  ],
