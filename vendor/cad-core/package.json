{
  "name": "instantcad-local",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun scripts/build.js",
    "preview": "bun scripts/serve.js",
    "test": "bun test tests/*.test.js",
    "test:browser": "bun tests/browser.js",
    "test:routes": "bun tests/routes-browser.js",
    "test:assembly-capture": "bun tests/assembly-capture-browser.js",
    "build:vscode": "bun scripts/build-vscode.js",
    "package:vscode": "bun run build:vscode && cd extensions/vscode && bun ../../node_modules/@vscode/vsce/vsce package --allow-missing-repository --skip-license --target darwin-arm64",
    "test:vscode": "bun run build:vscode && bun scripts/test-vscode.js"
  },
  "dependencies": {
    "brepjs": "19.0.5",
    "occt-wasm": "5.3.2",
    "es-module-lexer": "1.7.0"
  },
  "devDependencies": {
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "playwright": "1.58.2"
  },
  "license": "MIT"
}
